{
  "name": "edgelab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Forward DreamDEX Event Contract evidence and calibration laboratory.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "dev": "pnpm --filter @edgelab/server dev",
    "lint": "eslint . --max-warnings=0",
    "secret:scan": "node scripts/secret-scan.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^8.2.0",
    "@somnia-chain/markets-sdk": "0.28.1",
    "@vitejs/plugin-react": "^5.0.2",
    "fastify": "^5.5.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "viem": "^2.35.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
